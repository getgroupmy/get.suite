# NAS Workspace mail server — Postfix.
# Mail tables live in /run/nw/postfix and are generated by the Workspace app.
compatibility_level = 3.6
myhostname = mail.localdomain
myorigin = $myhostname
mydestination = localhost
mynetworks = 127.0.0.0/8 [::1]/128
inet_interfaces = all
inet_protocols = ipv4
biff = no
append_dot_mydomain = no
readme_directory = no
maillog_file = /dev/stdout
alias_maps =
alias_database =

# --- hosted domains (virtual) ---
virtual_mailbox_domains = texthash:/run/nw/postfix/domains
virtual_mailbox_maps = texthash:/run/nw/postfix/mailboxes
virtual_alias_maps = texthash:/run/nw/postfix/aliases
virtual_transport = lmtp:unix:private/dovecot-lmtp
recipient_delimiter = +
message_size_limit = 52428800
mailbox_size_limit = 0

# --- TLS ---
smtpd_tls_cert_file = /run/nw-tls/fullchain.pem
smtpd_tls_key_file = /run/nw-tls/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_loglevel = 1
smtp_tls_security_level = may
smtp_tls_loglevel = 1
smtp_tls_CApath = /etc/ssl/certs

# --- authentication via Dovecot (submission ports only, see master.cf) ---
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = no
smtpd_sender_login_maps = texthash:/run/nw/postfix/senders

# --- inbound policy (port 25) ---
smtpd_helo_required = yes
disable_vrfy_command = yes
strict_rfc821_envelopes = yes
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_pipelining, reject_non_fqdn_recipient, reject_unknown_recipient_domain, reject_unauth_destination
smtpd_sender_restrictions = reject_non_fqdn_sender, reject_unknown_sender_domain
smtpd_data_restrictions = reject_unauth_pipelining

# --- spam filtering and DKIM signing via Rspamd ---
smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = $smtpd_milters
milter_protocol = 6
milter_default_action = accept
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}
